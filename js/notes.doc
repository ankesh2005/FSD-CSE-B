Advanced feature of Es-6 js:

1. Arrow function
2. let and const
3. promise
4. destructuring
5. spread & rest  (...)
6. modules
7. filter,map,reduce
8. template literal ``
9. fetch

function f1(user="guest"){
  console.log(`hello ${user}`);
}
f1();
f1("ankesh");

console:-
hello guest
hello ankesh

const add=(a,b)=>a+b;
function sum(a,b){
  console.log("before return");
  return (a+b);
  console.log("after return")
}

console.log(sum(10,20));

console:-
before return
30


callback function:- 

function f1(user,cb){
  console.log(`hello ${user}`);
  cb();
}
function logn(){
  console.log("callback function");
}
f1("ankesh",logn);

console:- 
hello ankesh
callback function

